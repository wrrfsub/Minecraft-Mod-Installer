{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "mod-installer",
    "name": "Mod Installer",
    "version": "1.0.0",
    "description": "Let users install Minecraft mods from Modrinth and CurseForge.",
    "author": "s4way",
    "icon": "package",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.5 <3.0",
        "php": "^8.3"
    },
    "provider": "ModInstaller\\ModInstallerProvider",
    "autoload": {
        "ModInstaller\\": "src"
    },
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "mdi",
        "screens": [
            {
                "id": "mods",
                "area": "server",
                "path": "mod-installer",
                "nav": {
                    "label": "Mods",
                    "icon": "package"
                },
                "permission": [
                    "file.read"
                ],
                "when": {
                    "runtime": true
                }
            }
        ]
    }
}
